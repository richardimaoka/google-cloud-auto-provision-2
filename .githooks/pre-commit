#!/usr/bin/env bash
# Stops a commit that would put real identifiers into gcp/sampledata.
#
# Enable it once per clone: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# The raw responses in scripts/samples/out/ hold real identifiers. It is
# git-ignored, so this only happens with `git add -f`.
if git diff --cached --name-only | grep -q '^scripts/samples/out/'; then
  echo "pre-commit: files in scripts/samples/out/ are staged. They hold real identifiers and must not be committed." >&2
  exit 1
fi

samples="$(git diff --cached --name-only --diff-filter=ACMR | grep '^gcp/sampledata/.*\.json$' || true)"
if [ -z "${samples}" ]; then
  exit 0
fi

# The check reads the working tree, so it must see what is staged.
while IFS= read -r file; do
  if ! git diff --quiet -- "${file}"; then
    echo "pre-commit: ${file} has changes that are not staged. Run git add ${file}, so the check sees what is committed." >&2
    exit 1
  fi
done <<<"${samples}"

echo "pre-commit: checking that the samples hold placeholders only" >&2
if ! go test -count=1 ./cmd/anonymize >&2; then
  echo "pre-commit: a sample does not hold placeholders only. Run: go run ./cmd/anonymize scripts/samples/out/<name>.json" >&2
  exit 1
fi
