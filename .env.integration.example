# Variables for the integration tests in googlecloud (go test -tags integration).
# Copy to .env.integration, which is git-ignored, and fill in real values:
#
#   cp .env.integration.example .env.integration
#   (set -a; . ./.env.integration; set +a; go test -tags integration -count=1 ./googlecloud)
#
# See groups_integration_test.go for what each fixture must look like.

# Control project, where this app runs. It is the quota project, so it must
# match the project recorded in ADC
# (gcloud auth application-default set-quota-project <project>).
GOOGLECLOUD_TEST_CONTROL_PROJECT=example-project

# Groups tests: a domain and fixture groups in it.
GOOGLECLOUD_TEST_DOMAIN=example.com
GOOGLECLOUD_TEST_GROUP_EMPTY=it-empty@example.com
GOOGLECLOUD_TEST_GROUP_MIXED_ROLES=it-mixed-roles@example.com
GOOGLECLOUD_TEST_GROUP_LARGE=it-large@example.com
GOOGLECLOUD_TEST_GROUP_SAME_DOMAIN=it-same-domain@example.com
GOOGLECLOUD_TEST_GROUP_EXTERNAL=it-external@example.com
